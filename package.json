  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "mermaid",
    "svg"
  ],
  "author": "towishy",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.1",
    "obsidian": "latest",
    "typescript": "^5.5.4"
  }
}
