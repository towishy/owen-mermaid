{
  "name": "owen-mermaid",
  "version": "0.1.0",
  "description": "Zoom, edit, and export Mermaid SVG diagrams in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
