{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "canvas": { "$type": "color", "$value": "#f7f8fa" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "surfaceMuted": { "$type": "color", "$value": "#f1f3f5" },
    "text": { "$type": "color", "$value": "#18181b" },
    "textMuted": { "$type": "color", "$value": "#5f6672" },
    "border": { "$type": "color", "$value": "#dfe3e8" },
    "primary": { "$type": "color", "$value": "#4f46e5" },
    "primaryText": { "$type": "color", "$value": "#ffffff" },
    "success": { "$type": "color", "$value": "#047857" },
    "warning": { "$type": "color", "$value": "#b45309" },
    "danger": { "$type": "color", "$value": "#b91c1c" },
    "dangerSurface": { "$type": "color", "$value": "#b91c1c" },
    "focus": { "$type": "color", "$value": "#2563eb" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
    "panel": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "roundedPanel": {
      "$type": "dimension",
      "$value": { "value": 32, "unit": "px" },
      "$extensions": {
        "org.owen.css": "clamp(16px, 15%, 32px)",
        "org.owen.ratio": 0.15
      }
    },
    "showcase": {
      "$type": "dimension",
      "$value": { "value": 104, "unit": "px" },
      "$extensions": {
        "org.owen.css": "clamp(40px, 15cqi, 104px)",
        "org.owen.ratio": 0.15
      }
    },
    "identityRatio": { "$type": "number", "$value": 0.21 },
    "pill": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
  },
  "material": {
    "clearGlass": {
      "border": { "$type": "color", "$value": "#ffffffe0" },
      "borderLow": { "$type": "color", "$value": "#d2d7dd80" },
      "fill": {
        "$type": "color",
        "$value": "#ffffff2e",
        "$extensions": {
          "org.owen.css": "linear-gradient(180deg, rgb(255 255 255 / 0.46), rgb(255 255 255 / 0.14)), rgb(255 255 255 / 0.18)"
        }
      },
      "backdropFilter": { "$type": "string", "$value": "blur(1.5rem) saturate(132%) brightness(1.04)" },
      "shadow": { "$type": "string", "$value": "inset 1px 1px 0 rgb(255 255 255 / 0.96), inset -1px -1px 0 rgb(255 255 255 / 0.38), 0 0.85rem 2rem rgb(55 65 81 / 0.12), 0 0.2rem 0.6rem rgb(55 65 81 / 0.05)" }
    }
  },
  "motion": {
    "durationFast": { "$type": "duration", "$value": { "value": 140, "unit": "ms" } },
    "durationNormal": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
    "easeOut": { "$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1] },
    "easeInOut": { "$type": "cubicBezier", "$value": [0.77, 0, 0.175, 1] }
  }
}